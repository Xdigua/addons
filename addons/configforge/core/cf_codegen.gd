@tool
class_name CFCodeGen
extends RefCounted

## 配置工坊 · GDScript 代码生成
##
## 产物与 Luban 的 gdscript-json 目标对齐，力求「换成本工具生成后，业务代码不用改」：
##   enum X { A = 1, ... }
##   class Bean extends Parent:  var id: int ... _init(_json_) / get_data() / get_type_id()
##   class TbItem: _data_list / _data_map / get_data_list() / get_data_map() / get_item(key)
##   class CfgTables: tbItem ... _init(loader: Callable)
## loader.gd: CfgLoader.load_tables(data_dir) -> Schema.CfgTables
##
## 与官方产物的差异（有意为之）：
##   1. 字段赋值多一层 int()/float()/bool()/str() 收敛：JSON 里的数字若被解析成浮点，
##      直接赋给 int 变量会运行时报错，收敛一下更稳。
##   2. 多态字段（基类声明了 variants）在生成代码里保留为 Dictionary，由调用方按 $type
##      自行分派；编辑器、校验、CLI 仍完整支持多态。这样生成代码不依赖「同文件内前向
##      引用内部类」，稳定性优先。
##   3. __type_id__ 用 FNV-1a 计算，与官方数值不保证一致（仅本工具链内部标识用）。

const HEADER := """#  <auto-generated>
#    This code was generated by ConfigForge (配置工坊).
#    Do not edit by hand - regenerate from the editor dock or the CLI.
#  </auto-generated>
"""

const INDENT := "    "


# ---------------------------------------------------------------- 入口

## 生成全部代码文本。返回 { schema_gd, loader_gd }。
static func generate(schema: CFSchema, tables: Array, data_dir: String = "res://configforge/out", code_dir: String = "res://configforge/out", merged_file: String = "config.json") -> Dictionary:
	return {
		"schema_gd": build_schema_gd(schema, tables),
		"loader_gd": build_loader_gd(code_dir.rstrip("/") + "/schema.gd", data_dir, merged_file),
	}


## schema.gd：枚举 + 结构类 + 表类 + CfgTables。
static func build_schema_gd(schema: CFSchema, tables: Array) -> String:
	var lines: Array = []
	lines.append(HEADER)
	lines.append("@tool")
	lines.append("class_name Schema")
	lines.append("extends RefCounted")
	lines.append("")

	for ename in schema.enums.keys():
		var e: Dictionary = schema.enums[ename]
		lines.append("")
		var ecomment := str(e["comment"])
		if ecomment != "":
			lines.append("# %s" % ecomment)
		# 花括号与 enum 同行：不依赖「enum 名换行再写 {」这种写法能否被解析
		lines.append("enum %s {" % ename)
		for vname in e["order"]:
			lines.append("%s%s = %d," % [INDENT, str(vname), int(e["values"][vname])])
		lines.append("}")
	lines.append("")

	# 父类先于子类，保证 `class Child extends Parent` 里的 Parent 已声明
	for bname in _order_beans(schema):
		lines.append_array(_build_bean(schema, bname))
		lines.append("")

	for table in tables:
		lines.append_array(_build_table(table))
		lines.append("")

	lines.append_array(_build_tables_root(tables))
	lines.append("")
	return "\n".join(lines)


## loader.gd：运行时加载器。
##
## 刻意**不**引用 `Schema` 这个全局类名，而是运行时 load() 取常量表：
## 生成瞬间 cfg/loader.gd 与 cfg/schema.gd 会同时进扫描队列，而扫描按路径字典序进行
## （loader < schema），若这里写了 `-> Schema.CfgTables`，首次扫描就会报
## "Identifier Schema not declared"。改用 load() 后不再依赖类注册顺序。
static func build_loader_gd(schema_file: String, data_dir: String, merged_file: String = "config.json") -> String:
	var lines: Array = []
	lines.append(HEADER)
	lines.append("@tool")
	lines.append("class_name CfgLoader")
	lines.append("extends RefCounted")
	lines.append("")
	lines.append("## 运行时加载器：构建 Schema.CfgTables。")
	lines.append("## 数据优先从合并文件（%s）读，缺了再回退到每张表一个 <表名小写>.json。" % merged_file)
	lines.append("## 用法：var tables = CfgLoader.load_tables()")
	lines.append("")
	lines.append("const SCHEMA_PATH := \"%s\"" % schema_file)
	lines.append("const DEFAULT_DATA_DIR := \"%s\"" % data_dir)
	lines.append("const MERGED_FILE := \"%s\"" % merged_file)
	lines.append("")
	lines.append("")
	lines.append("static func load_tables(data_dir: String = DEFAULT_DATA_DIR):")
	lines.append("%svar schema_script: GDScript = load(SCHEMA_PATH)" % INDENT)
	lines.append("%sif schema_script == null:" % INDENT)
	lines.append("%s%spush_error(\"CfgLoader: 无法加载 \" + SCHEMA_PATH)" % [INDENT, INDENT])
	lines.append("%s%sreturn null" % [INDENT, INDENT])
	lines.append("%svar consts: Dictionary = schema_script.get_script_constant_map()" % INDENT)
	lines.append("%svar tables_class: Variant = consts.get(\"CfgTables\")" % INDENT)
	lines.append("%sif tables_class == null:" % INDENT)
	lines.append("%s%spush_error(\"CfgLoader: \" + SCHEMA_PATH + \" 里没有 CfgTables，请重新生成\")" % [INDENT, INDENT])
	lines.append("%s%sreturn null" % [INDENT, INDENT])
	lines.append("")
	lines.append("%s# 先尝试合并文件：{ \"tbitem\": [...], \"tbmonster\": [...] }" % INDENT)
	lines.append("%svar merged: Dictionary = {}" % INDENT)
	lines.append("%svar merged_path: String = data_dir.rstrip(\"/\") + \"/\" + MERGED_FILE" % INDENT)
	lines.append("%sif FileAccess.file_exists(merged_path):" % INDENT)
	lines.append("%s%svar merged_parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(merged_path))" % [INDENT, INDENT])
	lines.append("%s%sif merged_parsed is Dictionary:" % [INDENT, INDENT])
	lines.append("%s%s%smerged = merged_parsed" % [INDENT, INDENT, INDENT])
	lines.append("%s%selse:" % [INDENT, INDENT])
	lines.append("%s%s%spush_error(\"CfgLoader: 合并数据不是对象 \" + merged_path)" % [INDENT, INDENT, INDENT])
	lines.append("")
	lines.append("%svar loader := func(table_name: String) -> Variant:" % INDENT)
	lines.append("%s%sif merged.has(table_name):" % [INDENT, INDENT])
	lines.append("%s%s%sreturn merged[table_name]" % [INDENT, INDENT, INDENT])
	lines.append("%s%svar path: String = data_dir.rstrip(\"/\") + \"/\" + table_name + \".json\"" % [INDENT, INDENT])
	lines.append("%s%sif not FileAccess.file_exists(path):" % [INDENT, INDENT])
	lines.append("%s%s%spush_error(\"CfgLoader: 找不到配置数据 \" + path + \"（也没有 \" + MERGED_FILE + \"）\")" % [INDENT, INDENT, INDENT])
	lines.append("%s%s%sreturn []" % [INDENT, INDENT, INDENT])
	lines.append("%s%svar text := FileAccess.get_file_as_string(path)" % [INDENT, INDENT])
	lines.append("%s%svar parsed: Variant = JSON.parse_string(text)" % [INDENT, INDENT])
	lines.append("%s%sif parsed == null:" % [INDENT, INDENT])
	lines.append("%s%s%spush_error(\"CfgLoader: JSON 解析失败 \" + path)" % [INDENT, INDENT, INDENT])
	lines.append("%s%s%sreturn []" % [INDENT, INDENT, INDENT])
	lines.append("%s%sreturn parsed" % [INDENT, INDENT])
	lines.append("%sreturn tables_class.new(loader)" % INDENT)
	lines.append("")
	return "\n".join(lines)


# ---------------------------------------------------------------- 结构类

static func _build_bean(schema: CFSchema, bean_name: String) -> Array:
	var lines: Array = []
	var bean: Dictionary = schema.beans[bean_name]
	var parent := str(bean["parent"])
	var comment := str(bean["comment"])
	if comment != "":
		lines.append("# %s" % comment)
	if bool(bean.get("polymorphic", false)):
		lines.append("# 多态基类，子类型：%s（数据里用 $type 分派到具体结构）" % str(bean["variants"]))
	if parent != "":
		lines.append("class %s extends %s:" % [bean_name, parent])
	else:
		lines.append("class %s:" % bean_name)

	var own: Array = bean["own_fields"]
	if parent == "":
		# 根结构持有原始 JSON，供 get_data() 回读
		own = bean["fields"]
		lines.append("%svar _data: Dictionary" % INDENT)
	else:
		# 子类不能重复声明父类已声明的成员，否则 GDScript 报「成员已存在于父类」；
		# 被覆盖的字段由 super._init() 用同一份 _json_ 赋值，值仍然正确。
		own = _fields_not_in_parent(schema, parent, own)
	for f in own:
		lines.append("%svar %s: %s" % [INDENT, str(f["name"]), _gd_type(schema, f)])
	lines.append("")
	# 不声明 __type_id__ 成员：Godot 4.7 中「子类重复声明父类已有成员」是硬错误
	# （The member "xxx" already exists in parent class），而 Effect → DamageEffect 这类
	# 继承必然重复。改成 get_type_id() 直接返回字面量，每个类各返回自己的 id。
	lines.append("%sfunc get_type_id() -> int:" % INDENT)
	lines.append("%s%sreturn %d" % [INDENT, INDENT, CFTypeSystem.type_id(bean_name)])
	lines.append("")
	lines.append("%sfunc _init(_json_: Dictionary) -> void:" % INDENT)
	if parent != "":
		lines.append("%s%ssuper._init(_json_)" % [INDENT, INDENT])
	lines.append("%s%sself._data = _json_" % [INDENT, INDENT])
	for f in own:
		lines.append_array(_init_lines(schema, f, 2))
	lines.append("")
	lines.append("%sfunc get_data() -> Dictionary:" % INDENT)
	lines.append("%s%sreturn self._data" % [INDENT, INDENT])
	return lines


## 过滤掉父类已声明的字段（同名），避免生成重复成员声明。
static func _fields_not_in_parent(schema: CFSchema, parent_name: String, own: Array) -> Array:
	if not schema.beans.has(parent_name):
		return own
	var inherited: Dictionary = {}
	for f in schema.beans[parent_name]["fields"]:
		inherited[str(f["name"])] = true
	var out: Array = []
	for f in own:
		if not inherited.has(str(f["name"])):
			out.append(f)
	return out


## 单字段赋值语句。缩进以 INDENT 为单位（level=2 表示函数体内）。
static func _init_lines(schema: CFSchema, field: Dictionary, level: int) -> Array:
	var lines: Array = []
	var pad := INDENT.repeat(level)
	var fname := str(field["name"])
	var info: Dictionary = field["info"]
	var access := "_json_[\"%s\"]" % fname
	match str(field["kind"]):
		"list":
			var elem: Dictionary = info.get("elem", {})
			lines.append("%sself.%s = []" % [pad, fname])
			lines.append("%sfor _ele_ in %s:" % [pad, access])
			lines.append("%s%sself.%s.append(%s)" % [pad, INDENT, fname, _elem_expr(schema, elem, "_ele_")])
		"bean":
			if _is_polymorphic(schema, info):
				lines.append("%sself.%s = %s" % [pad, fname, access])
			else:
				lines.append("%sself.%s = %s.new(%s)" % [pad, fname, str(info["type"]), access])
		"map":
			lines.append("%sself.%s = %s" % [pad, fname, access])
		"scalar":
			lines.append("%sself.%s = %s" % [pad, fname, _cast_expr(str(info["type"]), access)])
		"enum":
			lines.append("%sself.%s = int(%s)" % [pad, fname, access])
		_:
			lines.append("%sself.%s = %s" % [pad, fname, access])
	return lines


## 容器元素表达式：标量收敛、结构 new、多态结构与嵌套容器原样收。
static func _elem_expr(schema: CFSchema, elem: Dictionary, expr: String) -> String:
	match str(elem.get("kind", "")):
		"scalar":
			return _cast_expr(str(elem.get("type", "")), expr)
		"enum":
			return "int(%s)" % expr
		"bean":
			if _is_polymorphic(schema, elem):
				return expr
			return "%s.new(%s)" % [str(elem.get("type", "")), expr]
	return expr


## 标量赋值时套一层收敛转换：JSON 的数字被解析成浮点也不会把 int 变量写崩。
static func _cast_expr(scalar: String, expr: String) -> String:
	match scalar:
		"int":
			return "int(%s)" % expr
		"float":
			return "float(%s)" % expr
		"bool":
			return "bool(%s)" % expr
		"string":
			return "str(%s)" % expr
	return expr


## 生成用的类型标注：可空字段退化为 Variant、多态字段退化为 Dictionary、
## 嵌套容器退化为无类型 Array（Array[Array[int]] 这类写法不受支持）。
static func _gd_type(schema: CFSchema, field: Dictionary) -> String:
	var info: Dictionary = field["info"]
	if bool(info.get("nullable", false)):
		return "Variant"
	var kind := str(info.get("kind", ""))
	if kind == "bean":
		if _is_polymorphic(schema, info):
			return "Dictionary"
	if kind == "list":
		var elem: Dictionary = info.get("elem", {})
		var elem_kind := str(elem.get("kind", ""))
		if elem_kind == "list":
			return "Array"
		if elem_kind == "bean" and _is_polymorphic(schema, elem):
			return "Array"
	return CFTypeSystem.gd_type(info)


## 该字段是不是「多态基类」：是的话生成代码里保留 Dictionary，由调用方按 $type 分派。
static func _is_polymorphic(schema: CFSchema, info: Dictionary) -> bool:
	if str(info.get("kind", "")) != "bean":
		return false
	var type_name := str(info.get("type", ""))
	if not schema.beans.has(type_name):
		return false
	return not schema.beans[type_name].get("variants", []).is_empty()


# ---------------------------------------------------------------- 表类

## 一张表 → 一个 TbXxx 类：_data_list 保持顺序，_data_map 按索引字段建映射。
static func _build_table(table: Dictionary) -> Array:
	var lines: Array = []
	var tname := str(table["name"])
	var bean_name := str(table["bean_name"])
	var comment := str(table.get("comment", ""))
	if comment != "":
		lines.append("# %s" % comment)
	lines.append("# 数据文件：%s.json" % str(table["file_stem"]))
	lines.append("class %s:" % tname)
	lines.append("%svar _data_list: Array[%s]" % [INDENT, bean_name])
	lines.append("%svar _data_map: Dictionary" % INDENT)
	lines.append("")
	lines.append("%sfunc _init(_json_: Array) -> void:" % INDENT)
	lines.append("%s%sfor _json2_ in _json_:" % [INDENT, INDENT])
	lines.append("%s%s%svar _v: %s = %s.new(_json2_)" % [INDENT, INDENT, INDENT, bean_name, bean_name])
	lines.append("%s%s%sself._data_list.append(_v)" % [INDENT, INDENT, INDENT])
	var index := str(table.get("index", ""))
	if index != "":
		lines.append("%s%s%sself._data_map[_v.%s] = _v" % [INDENT, INDENT, INDENT, index])
	else:
		lines.append("%s%s%sself._data_map[self._data_list.size() - 1] = _v" % [INDENT, INDENT, INDENT])
	lines.append("")
	lines.append("%sfunc get_data_list() -> Array[%s]:" % [INDENT, bean_name])
	lines.append("%s%sreturn self._data_list" % [INDENT, INDENT])
	lines.append("")
	lines.append("%sfunc get_data_map() -> Dictionary:" % INDENT)
	lines.append("%s%sreturn self._data_map" % [INDENT, INDENT])
	lines.append("")
	lines.append("%sfunc get_item(key) -> %s:" % [INDENT, bean_name])
	lines.append("%s%sreturn self._data_map.get(key)" % [INDENT, INDENT])
	return lines


## 总表 CfgTables：一个成员一张表，_init 用 loader 回调按表名取 JSON。
## loader 契约与 Luban 一致：loader.call("tbitem") 返回该表的数组。
static func _build_tables_root(tables: Array) -> Array:
	var lines: Array = []
	lines.append("class CfgTables:")
	for table in tables:
		lines.append("%svar %s: %s" % [INDENT, str(table["member"]), str(table["name"])])
	lines.append("")
	lines.append("%sfunc _init(loader: Callable) -> void:" % INDENT)
	for table in tables:
		lines.append("%s%sself.%s = %s.new(loader.call(\"%s\"))" % [
			INDENT, INDENT, str(table["member"]), str(table["name"]), str(table["file_stem"])])
	return lines


# ---------------------------------------------------------------- 排序

## 父类先于子类：拓扑排序，保证 `class Child extends Parent` 里 Parent 已声明。
static func _order_beans(schema: CFSchema) -> Array:
	var ordered: Array = []
	var placed: Dictionary = {}
	var names: Array = schema.beans.keys()
	var guard := 0
	while ordered.size() < names.size() and guard < names.size() * names.size() + 8:
		guard += 1
		var progressed := false
		for name in names:
			if placed.has(name):
				continue
			var parent := str(schema.beans[name]["parent"])
			if parent == "" or placed.has(parent) or not schema.beans.has(parent):
				ordered.append(name)
				placed[name] = true
				progressed = true
		if not progressed:
			# 继承成环或缺父类：剩余结构按原序补齐，问题交给校验器报
			for name in names:
				if not placed.has(name):
					ordered.append(name)
					placed[name] = true
			break
	return ordered
